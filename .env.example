# Frontend (build-time, PUBLIC — the anon key is designed to ship to browsers;
# RLS protects the data). Copy to .env for local dev; set the same two vars in
# the Vercel project settings for deploys.
NG_APP_SUPABASE_URL=https://<project-ref>.supabase.co
NG_APP_SUPABASE_ANON_KEY=<anon-key>

# Edge function secrets — NOT used by the frontend build. Set via:
#   supabase secrets set GEMINI_API_KEY=... TMDB_API_KEY=...
# (SUPABASE_SERVICE_ROLE_KEY is auto-available in the edge runtime.)
# GEMINI_API_KEY=
# TMDB_API_KEY=   (v4 read access token, used as a Bearer token)
